{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Pin (Desktop)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "linux",
      "flutterMode": "debug"
    },
    {
      "name": "Pin (Web - Server)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "web-server",
      "flutterMode": "debug",
      "args": ["--web-port", "5000", "--web-hostname", "0.0.0.0"]
    },
    {
      "name": "Pin (Web - Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "flutterMode": "debug",
      "args": ["--web-port", "5000"]
    },
    {
      "name": "Pin (Smartphone / Connected Device)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "debug"
    },
    {
      "name": "Pin (Pixel)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "android",
      "flutterMode": "debug"
    },
    {
      "name": "Pin (Desktop Release)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "linux",
      "flutterMode": "release"
    }
  ]
}
